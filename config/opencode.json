{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3:8b",
  "small_model": "ollama/llama3.2:latest",
  "default_agent": "assistant",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 1800000,
        "chunkTimeout": false
      },
      "models": {
        "qwen3:8b": {
          "name": "Qwen3 8B (thinking)",
          "options": {
            "num_ctx": 32768
          }
        },
        "qwen3:4b": {
          "name": "Qwen3 4B (thinking, fast)",
          "options": {
            "num_ctx": 16384
          }
        },
        "llama3.2:latest": {
          "name": "Llama 3.2 (fast, no-think)",
          "options": {
            "num_ctx": 8192
          }
        },
        "moondream": {
          "name": "Moondream (vision)"
        },
        "nomic-embed-text": {
          "name": "Nomic Embed (search)"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "file *": "allow",
      "exiftool *": "allow",
      "ffprobe *": "allow",
      "stat *": "allow",
      "pwd": "allow",
      "date": "allow",
      "du *": "allow",
      "df *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git *": "ask",
      "mkdir *": "ask",
      "cp *": "ask",
      "mv *": "ask",
      "rm *": "ask",
      "fdupes *": "ask",
      "ollama list": "allow",
      "curl http://localhost:*": "allow"
    },
    "edit": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "~/*": "ask",
      "/tmp/*": "allow"
    }
  },
  "mcp": {
    "notion": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx", "-y", "@notionhq/notion-mcp-server"
      ],
      "environment": {
        "NOTION_TOKEN": "{env:NOTION_TOKEN}"
      }
    },
    "gmail": {
      "type": "local",
      "enabled": false,
      "command": [
        "npx", "-y", "@gongrzhe/server-gmail-autoauth-mcp"
      ],
      "environment": {
        "GMAIL_CREDENTIALS_PATH": "{env:HOME}/.config/local-ai/gmail/credentials.json",
        "GMAIL_TOKEN_PATH": "{env:HOME}/.config/local-ai/gmail/token.json"
      }
    }
  }
}
